# Database Configuration (For local development & Docker Compose testing)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skin_intelligence
POSTGRES_PORT=5432

# Backend URL & JWT
DATABASE_URL=postgresql://postgres:postgres@db:5432/skin_intelligence
JWT_SECRET=YOUR_SECURE_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend API URL
VITE_API_URL=http://localhost:8000
