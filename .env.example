# Used by docker-compose.yml for variable substitution.
# Copy this file to `.env` in the project root before running
# `docker compose up --build`. Do not commit the real `.env`.

# PostgreSQL
PGUSER=postgres
PGPASSWORD=change_this_password
PGDATABASE=ai_skin_intelligence
# Host-exposed port for the postgres container. 5433 (not Postgres's
# default 5432) since a local Postgres instance is often already running
# on 5432 — this is the port mapping on your host machine only; inside
# the Docker network the backend always reaches Postgres at 5432.
PGPORT=5433

# Backend
JWT_SECRET=replace_this_with_a_long_random_string
SESSION_SECRET=replace_this_with_another_long_random_string
CLIENT_URL=http://localhost:5173
MAX_UPLOAD_MB=5
ML_SERVICE_TIMEOUT_MS=8000

# Google OAuth (optional — leave blank to disable "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend (baked into the build — see frontend/Dockerfile)
VITE_API_URL=http://localhost:5000/api
VITE_SERVER_URL=http://localhost:5000
