# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
# IMPORTANT: this file must be saved as `backend/.env` (copy this file to
# that exact path/name — not project-root/.env, not backend/.env.txt).
# Do not wrap the password in quotes and do not leave trailing spaces.
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME are also accepted as
# aliases if you prefer that naming, but pick one convention consistently.
PGHOST=localhost
# 5433, not the Postgres default 5432 — set this way because a local
# Postgres instance is often already running on 5432. Change it if your
# own instance uses a different port.
PGPORT=5432
PGUSER=postgres
PGPASSWORD=durga@09
PGDATABASE=ai_skin_intelligence

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Session (needed by passport during OAuth handshake only; JWT is used after)
SESSION_SECRET=replace_this_with_another_long_random_string

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ML inference service (ml/inference/serve.py)
# If unset, or if the service is unreachable, report uploads automatically
# fall back to a simulated analysis instead of failing — see
# backend/src/utils/mlClient.js. Set this once you've run:
#   cd ml && python inference/serve.py
ML_SERVICE_URL=http://localhost:5001
ML_SERVICE_TIMEOUT_MS=8000
