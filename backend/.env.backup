# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skin_intelligence
DB_USER=postgres
DB_PASSWORD=root

# JWT Secrets
JWT_SECRET=skin_intelligence_jwt_super_secret_2026_do_not_share
JWT_REFRESH_SECRET=skin_intelligence_refresh_super_secret_2026_do_not_share
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS - Frontend origin
FRONTEND_URL=http://127.0.0.1:5500

# Google OAuth Credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Groq AI API Key
GROQ_API_KEY=your_groq_api_key_here

# Python Engine URL
PYTHON_API_URL=http://localhost:8001/api
