# --- App ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL (primary relational DB) ---
POSTGRES_USER=skincare
POSTGRES_PASSWORD=skincare
POSTGRES_DB=skincare_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://skincare:skincare@db:5432/skincare_db

# --- MongoDB (secondary doc store: logs, articles, lifestyle data) ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=skincare_docs
