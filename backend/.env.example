# Production Environment Variables Template for FastAPI Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_db
JWT_SECRET_KEY=generate_random_64_character_hex_string_here
JWT_REFRESH_SECRET_KEY=generate_another_random_64_character_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
