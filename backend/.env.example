# =========================================================================
# AI Skin Intelligence & Personalized Skincare Planner - Backend Environment
# =========================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_intelligence

# JWT Authentication & Security
JWT_SECRET=YOUR_SECURE_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated URLs, or * for open development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Google OAuth 2.0 SSO (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Notification Settings (Optional - In-app notifications function independently)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aiskinintelligence.com
EMAIL_FROM_NAME=AI Skin Intelligence
SMTP_USE_TLS=true

# Development Opt-in Flags (Keep false in production)
DEV_MOCK_ASSESSMENT=false
