# ==============================================================================
# AI Skin Intelligence & Personalized Skincare Planner - Backend Config Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this template to .env for local development or staging setup.
# Replace placeholder values with your local or cloud configuration.
# NEVER commit the active .env file to version control.
# ==============================================================================

# 1. DATABASE CONFIGURATION
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

# 2. SECURITY & JWT TOKENS
JWT_SECRET_KEY=<generate_random_64_character_hex_string_here>
JWT_REFRESH_SECRET_KEY=<generate_another_random_64_character_hex_string_here>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. NETWORKING, DOMAINS & CORS
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# 4. GOOGLE OAUTH 2.0 CREDENTIALS (Optional)
GOOGLE_CLIENT_ID=<your_google_client_id_here>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your_google_client_secret_here>

# 5. STORAGE SETTINGS
STORAGE_PROVIDER=local
STORAGE_BUCKET=<skin-planner-assets>
STORAGE_REGION=<region>
AWS_ACCESS_KEY_ID=<your_aws_access_key_id_here>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key_here>
MAX_UPLOAD_SIZE_MB=5

# 6. IDENTITY & EMAIL VERIFICATION
EMAIL_PROVIDER=CONSOLE
EMAIL_FROM=support@skincare-intelligence.com
SMTP_HOST=<smtp_host>
SMTP_PORT=587
SMTP_USER=<smtp_user>
SMTP_PASSWORD=<smtp_password>
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# 7. PHONE / SMS OTP VERIFICATION
# Options: CONSOLE (development mock without SMS), TWILIO (production live SMS), TEST (automated testing)
SMS_PROVIDER=CONSOLE
SMS_FROM=+1234567890
TWILIO_ACCOUNT_SID=<your_twilio_account_sid_here>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token_here>
PHONE_OTP_EXPIRE_MINUTES=10
