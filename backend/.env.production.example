# ==============================================================================
# AI Skin Intelligence Platform - Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env before deploying to production.
# Replace all <configure-in-cloud> placeholders with secure production secrets.
# NEVER commit the active .env file to version control.
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="AI Skin Intelligence & Personalized Skincare Planner"
APP_VERSION=1.0.0

# 2. SERVER BINDING & NETWORKING
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=https://api.skincare-intelligence.com
FRONTEND_URL=https://skincare-intelligence.com

# 3. DATABASE CONFIGURATION (Managed PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# 4. AUTHENTICATION & JWT SECURITY (Generate via: openssl rand -hex 32)
JWT_SECRET_KEY=<configure-in-cloud-64-char-hex-secret-key>
JWT_REFRESH_SECRET_KEY=<configure-in-cloud-64-char-hex-refresh-key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 5. CORS (Restricted to verified production origins)
CORS_ORIGINS=https://skincare-intelligence.com,https://www.skincare-intelligence.com

# 6. VERIFICATION & SECURITY TIMEOUTS
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PHONE_OTP_EXPIRE_MINUTES=10

# 7. GOOGLE OAUTH 2.0 INTEGRATION (Optional)
GOOGLE_CLIENT_ID=<configure-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<configure-google-client-secret>

# 8. EMAIL NOTIFICATION PROVIDER (SMTP / SENDGRID / SES)
EMAIL_PROVIDER=SMTP
EMAIL_FROM=notifications@skincare-intelligence.com
SMTP_HOST=<configure-smtp-host>
SMTP_PORT=587
SMTP_USER=<configure-smtp-user>
SMTP_PASSWORD=<configure-smtp-password>

# 9. SMS / TWILIO PROVIDER (TWILIO or CONSOLE)
SMS_PROVIDER=CONSOLE
SMS_FROM=+1234567890
TWILIO_ACCOUNT_SID=<configure-twilio-account-sid>
TWILIO_AUTH_TOKEN=<configure-twilio-auth-token>

# 10. CLOUD OBJECT STORAGE (S3 / GCS / Azure Blob)
STORAGE_PROVIDER=local
STORAGE_BUCKET=<configure-cloud-bucket-name>
STORAGE_REGION=<configure-cloud-region>
AWS_ACCESS_KEY_ID=<configure-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<configure-aws-secret-access-key>
MAX_UPLOAD_SIZE_MB=5
