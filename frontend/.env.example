# In production with NGINX, API requests are proxied via relative path: /api
# In local standalone development, point to: http://localhost:8000/api
VITE_API_BASE_URL=/api

# Google OAuth 2.0 Web Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
