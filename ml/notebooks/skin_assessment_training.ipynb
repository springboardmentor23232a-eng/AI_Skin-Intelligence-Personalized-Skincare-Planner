{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Skin Assessment Model Training (Module 3)\n",
    "\n",
    "This notebook trains a deep learning transfer-learning model to analyze facial skin photos and predict 18 severity metrics representing user skin characteristics. It implements data audit checks, data cleaning, validation set metrics reporting, and saves the trained model weights for production deployment."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Imports and Environment Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import copy\n",
    "import time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "from sklearn.metrics import root_mean_squared_error, mean_absolute_error\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import torchvision\n",
    "from torchvision import transforms, models\n",
    "\n",
    "# Set seeds for reproducibility\n",
    "torch.manual_seed(42)\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Dataset Paths"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "base_path = os.path.abspath(r\"../skin_type_classification_dataset\")\n",
    "train_xlsx = os.path.join(base_path, \"skinalaysis_labeling_train1.xlsx\")\n",
    "valid_xlsx = os.path.join(base_path, \"skinanalysis_valid1.xlsx\")\n",
    "train_img_dir = os.path.join(base_path, \"train\")\n",
    "valid_img_dir = os.path.join(base_path, \"valid\")\n",
    "test_img_dir = os.path.join(base_path, \"test\")\n",
    "\n",
    "print(\"Train Excel:\", train_xlsx)\n",
    "print(\"Validation Excel:\", valid_xlsx)\n",
    "print(\"Train Images:\", train_img_dir)\n",
    "print(\"Validation Images:\", valid_img_dir)\n",
    "print(\"Test Images:\", test_img_dir)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Loading the Excel Labels"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df_train = pd.read_excel(train_xlsx)\n",
    "df_valid = pd.read_excel(valid_xlsx)\n",
    "\n",
    "print(f\"Train Excel loaded: {df_train.shape[0]} rows, {df_train.shape[1]} columns\")\n",
    "print(f\"Validation Excel loaded: {df_valid.shape[0]} rows, {df_valid.shape[1]} columns\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Dataset Inspection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"--- TRAIN COLUMNS ---\")\n",
    "print(df_train.columns.tolist())\n",
    "\n",
    "print(\"\n--- VALIDATION COLUMNS ---\")\n",
    "print(df_valid.columns.tolist())\n",
    "\n",
    "# Check for columns misalignment\n",
    "train_only = set(df_train.columns) - set(df_valid.columns)\n",
    "valid_only = set(df_valid.columns) - set(df_train.columns)\n",
    "print(\"\nTrain-only columns:\", train_only)\n",
    "print(\"Validation-only columns:\", valid_only)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Exploratory Data Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Inspect unique values for each skin characteristics target\n",
    "target_cols = [c for c in df_train.columns if c not in ['Number', 'Image_ID']]\n",
    "for col in target_cols:\n",
    "    print(f\"{col} Train values:\", sorted(df_train[col].unique()))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Image/Label Matching"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_files_recursive(directory):\n",
    "    mapping = {}\n",
    "    if not os.path.exists(directory):\n",
    "        return mapping\n",
    "    for root, _, files in os.walk(directory):\n",
    "        for f in files:\n",
    "            mapping[f] = os.path.join(root, f)\n",
    "    return mapping\n",
    "\n",
    "train_img_map = get_files_recursive(train_img_dir)\n",
    "valid_img_map = get_files_recursive(valid_img_dir)\n",
    "\n",
    "# Validate matches\n",
    "train_match_count = sum(1 for img_id in df_train['Image_ID'] if img_id in train_img_map or f\"{img_id}.jpg\" in train_img_map)\n",
    "valid_match_count = sum(1 for img_id in df_valid['Image_ID'] if img_id in valid_img_map or f\"{img_id}.jpg\" in valid_img_map)\n",
    "\n",
    "print(f\"Matched Train Images: {train_match_count} / {len(df_train)}\")\n",
    "print(f"Matched Validation Images: {valid_match_count} / {len(df_valid)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Data Cleaning (Alignment & Preprocessing)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Align columns: valid has 'pigmentation(0-5)' while train has 'dark spots(0-5)'\n",
    "# We will rename train's 'dark spots(0-5)' to 'pigmentation(0-5)' for alignment\n",
    "df_train = df_train.rename(columns={'dark spots(0-5)': 'pigmentation(0-5)'})\n",
    "\n",
    "# Clean invalid values: cap 'Fine line around eyes(0-5)' outlier (like 11) to 5\n",
    "df_train['Fine line around eyes(0-5)'] = df_train['Fine line around eyes(0-5)'].clip(upper=5)\n",
    "print(\"Capped 'Fine line around eyes' values in train:\", sorted(df_train['Fine line around eyes(0-5)'].unique()))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Missing-Value Handling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check for missing label values in both excels\n",
    "target_cols = [c for c in df_train.columns if c not in ['Number', 'Image_ID']]\n",
    "print(\"Missing values in Train label columns:\", df_train[target_cols].isnull().sum().sum())\n",
    "print(\"Missing values in Validation label columns:\", df_valid[target_cols].isnull().sum().sum())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Duplicate Handling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Inspect duplicate records in train\n",
    "duplicates = df_train[df_train['Image_ID'].duplicated(keep=False)]\n",
    "print(f\"Duplicate records found in Train: {len(duplicates)}\")\n",
    "\n",
    "# Clean duplicates: keep first record instance\n",
    "df_train = df_train.drop_duplicates(subset=['Image_ID'], keep='first')\n",
    "print(f\"Train set shape after dropping duplicates: {df_train.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Image Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Transforms with resizing and normalization for Transfer Learning baseline models\n",
    "train_transforms = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.RandomHorizontalFlip(),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "val_transforms = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Label Preparation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Standardized target labels list\n",
    "LABEL_COLUMNS = [\n",
    "    'Acne_Severity (0-5)', 'blackheads', 'whiteheads', 'Open pores (0-5)', \n",
    "    'Excessive oil (0-5)', 'Skin irritation (0-5)', 'Skin sensitivity (0-5)', \n",
    "    'Redness Severity (0-5)', 'Fine line around eyes(0-5)', 'Eye puffiness(0-5)', \n",
    "    'Dark circles around eyes(0-5)', 'Wrinkes on forehead(0-5)', \n",
    "    'Skin elasticity(0-5)(5-not elastic at all)', 'Dehydration (0-5)(5 very dehydrated)', \n",
    "    'pigmentation(0-5)', 'post acne marks(0-5)', 'uneven skin(0-5)', 'freckles(0-5)'\n",
    "]\n",
    "\n",
    "print(f\"Number of targets: {len(LABEL_COLUMNS)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Train/Validation/Test Preparation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class SkinAssessmentDataset(Dataset):\n",
    "    def __init__(self, df, img_dir_map, label_cols, transform=None):\n",
    "        self.df = df.reset_index(drop=True)\n",
    "        self.img_dir_map = img_dir_map\n",
    "        self.label_cols = label_cols\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        img_id = str(row['Image_ID']).strip()\n",
    "        \n",
    "        # Resolve file path from mapping\n",
    "        img_path = self.img_dir_map.get(img_id)\n",
    "        if not img_path:\n",
    "            for ext in ['.jpg', '.png', '.jpeg', '.JPG']:\n",
    "                if f\"{img_id}{ext}\" in self.img_dir_map:\n",
    "                    img_path = self.img_dir_map[f\"{img_id}{ext}\"]\n",
    "                    break\n",
    "                    \n",
    "        # Load image\n",
    "        try:\n",
    "            image = Image.open(img_path).convert(\"RGB\")\n",
    "        except Exception as e:\n",
    "            raise FileNotFoundError(f\"Cannot load {img_id} at path {img_path}: {e}\")\n",
    "            \n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "            \n",
    "        # Extract labels and normalize from [0, 5] range to [0, 1] range for regression training\n",
    "        labels = row[self.label_cols].values.astype(np.float32) / 5.0\n",
    "        return image, torch.tensor(labels, dtype=torch.float32)\n",
    "\n",
    "train_dataset = SkinAssessmentDataset(df_train, train_img_map, LABEL_COLUMNS, train_transforms)\n",
    "val_dataset = SkinAssessmentDataset(df_valid, valid_img_map, LABEL_COLUMNS, val_transforms)\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=8, shuffle=True)\n",
    "val_loader = DataLoader(val_dataset, batch_size=8, shuffle=False)\n",
    "\n",
    "print(f\"Data loaders initialized. Train batches: {len(train_loader)}, Validation batches: {len(val_loader)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 13. Model Selection Explanation\n",
    "\n",
    "Given our small supervised dataset (149 unique training examples), training a convolution network from scratch is not viable as it would lead to immediate overfitting. We utilize **Transfer Learning** with a pretrained **ResNet-18** model. ResNet-18 is lightweight (11M parameters), runs quickly on CPU/GPU, generalizes well on smaller datasets, and is highly deployment-friendly."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 14. Transfer-Learning Model Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load pretrained ResNet-18 model as transfer learning baseline\n",
    "model = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\n",
    "\n",
    "# Freeze backbone weights to avoid overfitting on our small dataset\n",
    "for param in model.parameters():\n",
    "    param.requires_grad = False\n",
    "\n",
    "# Replace final fully connected layer with a regression head outputting 18 values\n",
    "num_features = model.fc.in_features\n",
    "model.fc = nn.Sequential(\n",
    "    nn.Linear(num_features, 128),\n",
    "    nn.ReLU(),\n",
    "    nn.Dropout(0.2),\n",
    "    nn.Linear(128, len(LABEL_COLUMNS)),\n",
    "    nn.Sigmoid() # Restricts output to [0, 1] range matching our normalized targets\n",
    ")\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "model = model.to(device)\n",
    "print(f\"Model loaded and mapped to device: {device}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 15. Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "criterion = nn.MSELoss()\n",
    "optimizer = optim.Adam(model.fc.parameters(), lr=0.001)\n",
    "\n",
    "num_epochs = 5\n",
    "best_val_loss = float('inf')\n",
    "best_model_weights = copy.deepcopy(model.state_dict())\n",
    "\n",
    "print(\"Starting training loop...\")\n",
    "for epoch in range(num_epochs):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "    for images, labels in train_loader:\n",
    "        images = images.to(device)\n",
    "        labels = labels.to(device)\n",
    "        \n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, labels)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        \n",
    "        running_loss += loss.item() * images.size(0)\n",
    "        \n",
    "    epoch_train_loss = running_loss / len(train_dataset)\n",
    "    \n",
    "    # Validate\n",
    "    model.eval()\n",
    "    val_loss = 0.0\n",
    "    with torch.no_grad():\n",
    "        for images, labels in val_loader:\n",
    "            images = images.to(device)\n",
    "            labels = labels.to(device)\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, labels)\n",
    "            val_loss += loss.item() * images.size(0)\n",
    "            \n",
    "    epoch_val_loss = val_loss / len(val_dataset)\n",
    "    print(f\"Epoch {epoch+1}/{num_epochs} - Train Loss: {epoch_train_loss:.4f} | Val Loss: {epoch_val_loss:.4f}\")\n",
    "    \n",
    "    if epoch_val_loss < best_val_loss:\n",
    "        best_val_loss = epoch_val_loss\n",
    "        best_model_weights = copy.deepcopy(model.state_dict())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 16. Validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load best model weights based on validation loss\n",
    "model.load_state_dict(best_model_weights)\n",
    "print(\"Loaded best model weights for evaluation!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 17. Model Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quantitative validation set metrics (RMSE & MAE) evaluation\n",
    "model.eval()\n",
    "all_preds = []\n",
    "all_labels = []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for images, labels in val_loader:\n",
    "        images = images.to(device)\n",
    "        outputs = model(images)\n",
    "        # Scale back to original [0, 5] range\n",
    "        all_preds.append(outputs.cpu().numpy() * 5.0)\n",
    "        all_labels.append(labels.numpy() * 5.0)\n",
    "\n",
    "preds_np = np.concatenate(all_preds, axis=0)\n",
    "labels_np = np.concatenate(all_labels, axis=0)\n",
    "\n",
    "overall_rmse = root_mean_squared_error(labels_np, preds_np)\n",
    "overall_mae = mean_absolute_error(labels_np, preds_np)\n",
    "\n",
    "print(f\"Validation Set Metrics:\")\n",
    "print(f\"Overall RMSE: {overall_rmse:.4f}\")\n",
    "print(f\"Overall MAE: {overall_mae:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 18. Test-Set Evaluation\n",
    "\n",
    "Since our test images at `test/` (409 images) do not have a corresponding labels Excel sheet, we cannot run quantitative metrics evaluation. Instead, the test images are utilized exclusively for qualitative sample predictions (visual inference validation)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 19. Sample Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run sample inference on a test file for qualitative output evaluation\n",
    "test_images_list = list(test_files_map.keys())\n",
    "if test_images_list:\n",
    "    sample_img_name = test_images_list[0]\n",
    "    sample_img_path = test_files_map[sample_img_name]\n",
    "    \n",
    "    image = Image.open(sample_img_path).convert(\"RGB\")\n",
    "    transformed_image = val_transforms(image).unsqueeze(0).to(device)\n",
    "    \n",
    "    model.eval()\n",
    "    with torch.no_grad():\n",
    "        preds = model(transformed_image).cpu().numpy()[0] * 5.0\n",
    "        \n",
    "    print(f\"Qualitative prediction on test image '{sample_img_name}':\")\n",
    "    for col_name, pred_val in zip(LABEL_COLUMNS, preds):\n",
    "        print(f\"  {col_name}: {pred_val:.2f} / 5.0\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 20. Saving the Best Trained Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "models_dir = os.path.abspath(r\"../models\")\n",
    "os.makedirs(models_dir, exist_ok=True)\n",
    "model_save_path = os.path.join(models_dir, \"skin_assessment_model.pth\")\n",
    "\n",
    "# Save PyTorch state dict\n",
    "torch.save(best_model_weights, model_save_path)\n",
    "print(f\"Best model weights successfully saved to: {model_save_path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 21. Preprocessing and Inference Output Format\n",
    "\n",
    "For live production API inference in FastAPI:\n",
    "1. **Input Dimensions:** 224x224 RGB image.\n",
    "2. **Normalization:** Subtraction of ImageNet Mean `[0.485, 0.456, 0.406]` and division by standard deviation `[0.229, 0.224, 0.225]`.\n",
    "3. **Inference Execution:** Run through ResNet-18 model head loaded with `.pth` state dict, apply Sigmoid activation.\n",
    "4. **Output Scaling:** Multiply raw model predictions (ranging in `[0, 1]`) by 5.0 to yield target severity values in `[0, 5]` range."
   ]
  }
 ],
