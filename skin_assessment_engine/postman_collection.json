              "});",
              "pm.test('Reflects updated parameters', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.hydration_level).to.eql(80.0);",
              "    pm.expect(jsonData.spf_frequency).to.eql('Daily');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hydration_level\": 80.0,\n  \"spf_frequency\": \"Daily\",\n  \"notes\": \"Updated assessment with improved hydration and regular SPF routine.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessment/1",
          "host": ["{{baseUrl}}"],
          "path": ["assessment", "1"]
        },
        "description": "Updates skin parameters/notes and re-calculates score, concerns, and risk factors."
      }
    },
    {
      "name": "9. Delete Assessment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Success message returned', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assessment/1",
          "host": ["{{baseUrl}}"],
          "path": ["assessment", "1"]
