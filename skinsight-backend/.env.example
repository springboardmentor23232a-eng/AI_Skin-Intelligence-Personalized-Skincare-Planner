# --- Server ---
PORT=5000
FRONTEND_URL=http://localhost:5500

# --- PostgreSQL ---
# Either set individual fields or DATABASE_URL — db.js supports both.
PGHOST=localhost
PGPORT=5432
PGDATABASE=skinsight
PGUSER=postgres
PGPASSWORD=change_me
# DATABASE_URL=postgresql://postgres:change_me@localhost:5432/skinsight

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Session (needed by passport for the OAuth handshake only) ---
SESSION_SECRET=replace_with_another_long_random_string

# --- Google OAuth2 ---
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
